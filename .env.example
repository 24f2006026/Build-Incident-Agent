# Free-tier Gemini API through its OpenAI-compatible endpoint
OPENAI_API_KEY=replace-with-gemini-api-key
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.8-flash
MODEL_TIMEOUT_SECONDS=13.5
# Use your external Neon Postgres connection string for persistent state.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
